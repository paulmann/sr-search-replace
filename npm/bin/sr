#!/usr/bin/env node
// =============================================================================
// sr — npm launcher
//
// The application is a Python zipapp bundled at ../app/sr.pyz.  This wrapper
// exists for three reasons:
//
//   1. npm installs executables from `bin`, and a `.pyz` would need a Python
//      shebang that npm does not normalise across platforms;
//   2. it can produce a *good* error when python3 is missing or too old,
//      instead of the shell's "cannot execute binary file";
//   3. it keeps the exit code and stdio transparent (inherit, no buffering).
//
// Everything else is Python: no logic lives here.
// =============================================================================
'use strict';

const { spawnSync } = require('child_process');
const fs = require('fs');
const path = require('path');

const APP = path.join(__dirname, '..', 'app', 'sr.pyz');
const MIN_PYTHON = [3, 10];
const REPO = 'https://github.com/paulmann/sr-search-replace';

function fail(message, hint) {
  process.stderr.write(`[sr] ${message}\n`);
  if (hint) process.stderr.write(`     ${hint}\n`);
  process.exit(127);
}

if (process.platform === 'win32') {
  fail(
    'Windows is not supported natively.',
    `Use WSL2 — sr relies on POSIX rename semantics. See ${REPO}#installation`
  );
}

if (!fs.existsSync(APP)) {
  fail(
    `the bundled application is missing: ${APP}`,
    'Reinstall with: npm install -g sr-search-replace'
  );
}

// Locate a Python >= 3.10.  SR_PYTHON wins, then the usual candidates.
function pythonVersion(binary) {
  const result = spawnSync(binary, ['-c', 'import sys;print("%d.%d" % sys.version_info[:2])'], {
    encoding: 'utf8',
    timeout: 10000,
  });
  if (result.status !== 0) return null;
  const parts = String(result.stdout).trim().split('.').map(Number);
  return parts.length === 2 && parts.every(Number.isFinite) ? parts : null;
}

function findPython() {
  const explicit = process.env.SR_PYTHON;
  const candidates = explicit
    ? [explicit]
    : ['python3', 'python3.14', 'python3.13', 'python3.12', 'python3.11', 'python3.10', 'python'];

  let sawPython = false;
  for (const candidate of candidates) {
    const version = pythonVersion(candidate);
    if (!version) continue;
    sawPython = true;
    if (version[0] > MIN_PYTHON[0] || (version[0] === MIN_PYTHON[0] && version[1] >= MIN_PYTHON[1])) {
      return candidate;
    }
  }
  if (sawPython) {
    fail(
      `Python ${MIN_PYTHON.join('.')} or newer is required.`,
      `Set SR_PYTHON=/path/to/python3 to point sr at a specific interpreter. See ${REPO}#installation`
    );
  }
  fail(
    'no Python 3 interpreter was found.',
    `Install Python ${MIN_PYTHON.join('.')}, or set SR_PYTHON=/path/to/python3. See ${REPO}#installation`
  );
  return null; // unreachable
}

const python = findPython();
const result = spawnSync(python, [APP, ...process.argv.slice(2)], {
  stdio: 'inherit',
  // The zipapp is a regular file; no shell involved, so arguments with spaces,
  // quotes and glob characters reach Python untouched.
  shell: false,
});

if (result.error) {
  fail(`cannot run ${python}: ${result.error.message}`);
}

// A null status means the child was killed by a signal; reproduce the
// conventional 128+N exit code so shells and CI see what really happened.
process.exit(result.status === null ? 128 + (result.signal ? os_signal(result.signal) : 0) : result.status);

function os_signal(name) {
  const table = { SIGHUP: 1, SIGINT: 2, SIGQUIT: 3, SIGTERM: 15 };
  return table[name] || 0;
}
