#compdef sr
# zsh completion for sr — generated by `sr completions zsh`
_sr() {
  local -a commands
  commands=(
    "replace:Search and replace text in files."
    "find:Show matches without changing anything."
    "diff:Preview changes as a unified diff."
    "rename:Rename files and directories by pattern."
    "rollback:Restore files from a session backup."
    "sessions:List, inspect and prune sessions."
    "update:Check for and install a newer sr release."
    "doctor:Check the installation and environment."
    "completions:Print shell completion scripts."
    "config:Inspect and manage configuration files."
    "selftest:Run the built-in smoke test."
    "help:Show the help system (topics, options, examples)."
  )
  local -a global_opts
  global_opts=(
    "(-v --verbose){-v,--verbose}[Show per-file results and the reason skipped files were skipped.]"
    "(-q --quiet){-q,--quiet}[Only errors; suitable for scripts.]"
    "--verbosity=[Set the log level explicitly (overrides -v/-q).]:LEVEL:(quiet|normal|verbose|debug)"
    "--color=[Colourise output. Honours NO_COLOR and CLICOLOR_FORCE.]:WHEN:(auto|always|never)"
    "--json[Emit a single JSON document on stdout; diagnostics go to stderr.]"
    "--help[Show help and exit]"
    "--help-all[Show help for every subcommand and option]"
    "--version[Print version information]"
    "--json[Emit a JSON document]"
    "--porcelain[Emit machine-readable records]"
    "--no-color[Disable colours]"
    "--debug[Debug logging]"
  )
  if (( CURRENT == 2 )); then
    _describe -t commands 'sr command' commands
    _files
    return
  fi
  local cmd="${words[2]}"
  case "$cmd" in
    replace)
      _arguments -s : $global_opts "(-C --target){-C,--target}=[Directory to operate on (default\: the current directory).]:DIR:_files" "(-p --pattern){-p,--pattern}=[Only files whose name matches GLOB (repeatable). Default\: every text file.]:GLOB:_files" "--file=[Explicit file to process, bypassing pattern matching (repeatable).]:PATH:_files" "--files-from=[Read the list of target files from FILE, one per line ('-' for stdin).]:FILE:_files" "--include=[Additional include glob, may contain '/' and '**' (repeatable).]:GLOB:_files" "--exclude=[Exclude glob; wins over --include and --pattern (repeatable).]:GLOB:_files" "--exclude-dir=[Prune a directory by name (repeatable; adds to the built-in list).]:NAME:_files" "--no-default-excludes[Do not apply the built-in exclude lists (node_modules, dist, *.bak …).]" "(-1 --no-recursive){-1,--no-recursive}[Only the target directory itself, no subdirectories.]" "--max-depth=[Descend at most N levels below the target directory.]:N: " "--hidden[Also process dotfiles and dot-directories.]" "--symlinks[Follow symlinked files (they are skipped by default).]" "--gitignore[Honour .gitignore files (including the global excludesfile).]" "--max-size=[Skip files larger than SIZE (default 100MB; a bare number means megabytes).]:SIZE: " "--min-size=[Skip files smaller than SIZE.]:SIZE: " "--newer-than=[Only files modified within AGE (e.g. 24h, 7d, 30m).]:AGE: " "--older-than=[Only files not modified within AGE.]:AGE: " "--binary[Process files that look binary instead of skipping them.]" "(-R --regex){-R,--regex}[Treat PATTERN as a Python regular expression.]" "--ere[Treat PATTERN as a POSIX Extended Regular Expression (grep -E syntax).]" "--pcre[Treat PATTERN as a Perl-compatible regular expression.]" "--pattern-kind=[Explicit pattern kind\: fixed, regex, ere or pcre.]:KIND:(fixed|regex|ere|pcre)" "(-i --ignore-case){-i,--ignore-case}[Case-insensitive matching.]" "(-w --word-boundary){-w,--word-boundary}[Match whole words only.]" "(-m --multiline){-m,--multiline}[Allow the pattern to span line boundaries ('.' matches newline).]" "--no-escapes[Do not interpret \\n, \\t, \\xNN in fixed patterns/replacements.]" "(-L --line-range){-L,--line-range}=[Restrict edits to a line range\: 10, 10-20, 10- or -20.]:RANGE: " "(-M --max-count){-M,--max-count}=[Replace at most N occurrences per file.]:N: " "--no-global[Replace only the first occurrence on each line.]" "--context=[Lines of context around a match in preview/diff output (default 3).]:N: " "(-n --dry-run){-n,--dry-run}[Report what would change; never write, never create a session.]" "--diff[Show a unified diff of every change (implies a preview).]" "(-I --interactive){-I,--interactive}[Confirm every hunk before it is written.]" "--write=[Where the result goes\: in-place (default), stdout, or --output-dir.]:MODE:(in-place|stdout|dir)" "(-o --output-dir){-o,--output-dir}=[Write modified copies under DIR, mirroring the tree (needs --write=dir).]:DIR:_files" "--suffix=[When writing copies, append EXT to the file name instead of mirroring.]:EXT: " "--rename[Also apply the replacement to file and directory names.]" "--rename-only[Rename matching files/directories without touching their content.]" "(-E --encoding){-E,--encoding}=[Force an encoding (utf-8, cp1251, latin-1 …); default is auto-detect.]:NAME: " "--encoding-error=[What to do with undecodable bytes\: strict (skip), replace, ignore.]:POLICY:(strict|replace|ignore)" "--line-endings=[Keep the file's line endings (default) or normalise to LF/CRLF.]:MODE:(preserve|lf|crlf)" "--preserve-mtime[Restore the original modification time after writing.]" "--backup[Store originals in a session so the run can be rolled back (default on).]" "--backup-dir=[Where to keep sessions (default <target>/.sr). Use an absolute path to keep them out of the tree.]:DIR:_files" "--keep=[Keep at most N sessions; older ones are pruned after a run (default 20, 0 disables pruning).]:N: " "--keep-age=[Also drop sessions older than AGE (e.g. 30d).]:AGE: " "--atomic[Write via a temporary file + rename (default) or rewrite the inode in place.]" "--lock[Take an advisory lock so two sr runs cannot interleave (default on).]" "--confirm-threshold=[Ask for confirmation when more than N files would change (0 disables).]:N: " "--allow-root[Permit a mutating run with euid 0 (refused by default).]" "(-f --force){-f,--force}[Override safety guards (drifted files, read-only warnings, existing targets).]" "(-y --yes){-y,--yes}[Answer 'yes' to every prompt; required for unattended runs in CI.]" "--porcelain[Emit stable 'path\:line\:col\:text' records, one per match.]" "--progress[Show a progress bar on a terminal (default on).]" "--summary[Print the run summary (default on).]" '*:file:_files'
      ;;
    find)
      _arguments -s : $global_opts "(-C --target){-C,--target}=[Directory to operate on (default\: the current directory).]:DIR:_files" "(-p --pattern){-p,--pattern}=[Only files whose name matches GLOB (repeatable). Default\: every text file.]:GLOB:_files" "--file=[Explicit file to process, bypassing pattern matching (repeatable).]:PATH:_files" "--files-from=[Read the list of target files from FILE, one per line ('-' for stdin).]:FILE:_files" "--include=[Additional include glob, may contain '/' and '**' (repeatable).]:GLOB:_files" "--exclude=[Exclude glob; wins over --include and --pattern (repeatable).]:GLOB:_files" "--exclude-dir=[Prune a directory by name (repeatable; adds to the built-in list).]:NAME:_files" "--no-default-excludes[Do not apply the built-in exclude lists (node_modules, dist, *.bak …).]" "(-1 --no-recursive){-1,--no-recursive}[Only the target directory itself, no subdirectories.]" "--max-depth=[Descend at most N levels below the target directory.]:N: " "--hidden[Also process dotfiles and dot-directories.]" "--symlinks[Follow symlinked files (they are skipped by default).]" "--gitignore[Honour .gitignore files (including the global excludesfile).]" "--max-size=[Skip files larger than SIZE (default 100MB; a bare number means megabytes).]:SIZE: " "--min-size=[Skip files smaller than SIZE.]:SIZE: " "--newer-than=[Only files modified within AGE (e.g. 24h, 7d, 30m).]:AGE: " "--older-than=[Only files not modified within AGE.]:AGE: " "--binary[Process files that look binary instead of skipping them.]" "(-R --regex){-R,--regex}[Treat PATTERN as a Python regular expression.]" "--ere[Treat PATTERN as a POSIX Extended Regular Expression (grep -E syntax).]" "--pcre[Treat PATTERN as a Perl-compatible regular expression.]" "--pattern-kind=[Explicit pattern kind\: fixed, regex, ere or pcre.]:KIND:(fixed|regex|ere|pcre)" "(-i --ignore-case){-i,--ignore-case}[Case-insensitive matching.]" "(-w --word-boundary){-w,--word-boundary}[Match whole words only.]" "(-m --multiline){-m,--multiline}[Allow the pattern to span line boundaries ('.' matches newline).]" "--no-escapes[Do not interpret \\n, \\t, \\xNN in fixed patterns/replacements.]" "(-L --line-range){-L,--line-range}=[Restrict edits to a line range\: 10, 10-20, 10- or -20.]:RANGE: " "(-M --max-count){-M,--max-count}=[Replace at most N occurrences per file.]:N: " "--no-global[Replace only the first occurrence on each line.]" "--context=[Lines of context around a match in preview/diff output (default 3).]:N: " "(-n --dry-run){-n,--dry-run}[Report what would change; never write, never create a session.]" "--diff[Show a unified diff of every change (implies a preview).]" "(-I --interactive){-I,--interactive}[Confirm every hunk before it is written.]" "(-E --encoding){-E,--encoding}=[Force an encoding (utf-8, cp1251, latin-1 …); default is auto-detect.]:NAME: " "--encoding-error=[What to do with undecodable bytes\: strict (skip), replace, ignore.]:POLICY:(strict|replace|ignore)" "--porcelain[Emit stable 'path\:line\:col\:text' records, one per match.]" "--progress[Show a progress bar on a terminal (default on).]" "--summary[Print the run summary (default on).]" '*:file:_files'
      ;;
    diff)
      _arguments -s : $global_opts "(-C --target){-C,--target}=[Directory to operate on (default\: the current directory).]:DIR:_files" "(-p --pattern){-p,--pattern}=[Only files whose name matches GLOB (repeatable). Default\: every text file.]:GLOB:_files" "--file=[Explicit file to process, bypassing pattern matching (repeatable).]:PATH:_files" "--files-from=[Read the list of target files from FILE, one per line ('-' for stdin).]:FILE:_files" "--include=[Additional include glob, may contain '/' and '**' (repeatable).]:GLOB:_files" "--exclude=[Exclude glob; wins over --include and --pattern (repeatable).]:GLOB:_files" "--exclude-dir=[Prune a directory by name (repeatable; adds to the built-in list).]:NAME:_files" "--no-default-excludes[Do not apply the built-in exclude lists (node_modules, dist, *.bak …).]" "(-1 --no-recursive){-1,--no-recursive}[Only the target directory itself, no subdirectories.]" "--max-depth=[Descend at most N levels below the target directory.]:N: " "--hidden[Also process dotfiles and dot-directories.]" "--symlinks[Follow symlinked files (they are skipped by default).]" "--gitignore[Honour .gitignore files (including the global excludesfile).]" "--max-size=[Skip files larger than SIZE (default 100MB; a bare number means megabytes).]:SIZE: " "--min-size=[Skip files smaller than SIZE.]:SIZE: " "--newer-than=[Only files modified within AGE (e.g. 24h, 7d, 30m).]:AGE: " "--older-than=[Only files not modified within AGE.]:AGE: " "--binary[Process files that look binary instead of skipping them.]" "(-R --regex){-R,--regex}[Treat PATTERN as a Python regular expression.]" "--ere[Treat PATTERN as a POSIX Extended Regular Expression (grep -E syntax).]" "--pcre[Treat PATTERN as a Perl-compatible regular expression.]" "--pattern-kind=[Explicit pattern kind\: fixed, regex, ere or pcre.]:KIND:(fixed|regex|ere|pcre)" "(-i --ignore-case){-i,--ignore-case}[Case-insensitive matching.]" "(-w --word-boundary){-w,--word-boundary}[Match whole words only.]" "(-m --multiline){-m,--multiline}[Allow the pattern to span line boundaries ('.' matches newline).]" "--no-escapes[Do not interpret \\n, \\t, \\xNN in fixed patterns/replacements.]" "(-L --line-range){-L,--line-range}=[Restrict edits to a line range\: 10, 10-20, 10- or -20.]:RANGE: " "(-M --max-count){-M,--max-count}=[Replace at most N occurrences per file.]:N: " "--no-global[Replace only the first occurrence on each line.]" "--context=[Lines of context around a match in preview/diff output (default 3).]:N: " "(-n --dry-run){-n,--dry-run}[Report what would change; never write, never create a session.]" "--diff[Show a unified diff of every change (implies a preview).]" "(-I --interactive){-I,--interactive}[Confirm every hunk before it is written.]" "(-E --encoding){-E,--encoding}=[Force an encoding (utf-8, cp1251, latin-1 …); default is auto-detect.]:NAME: " "--encoding-error=[What to do with undecodable bytes\: strict (skip), replace, ignore.]:POLICY:(strict|replace|ignore)" "--porcelain[Emit stable 'path\:line\:col\:text' records, one per match.]" "--progress[Show a progress bar on a terminal (default on).]" "--summary[Print the run summary (default on).]" '*:file:_files'
      ;;
    rename)
      _arguments -s : $global_opts "(-C --target){-C,--target}=[Directory to operate on (default\: the current directory).]:DIR:_files" "(-p --pattern){-p,--pattern}=[Only files whose name matches GLOB (repeatable). Default\: every text file.]:GLOB:_files" "--file=[Explicit file to process, bypassing pattern matching (repeatable).]:PATH:_files" "--files-from=[Read the list of target files from FILE, one per line ('-' for stdin).]:FILE:_files" "--include=[Additional include glob, may contain '/' and '**' (repeatable).]:GLOB:_files" "--exclude=[Exclude glob; wins over --include and --pattern (repeatable).]:GLOB:_files" "--exclude-dir=[Prune a directory by name (repeatable; adds to the built-in list).]:NAME:_files" "--no-default-excludes[Do not apply the built-in exclude lists (node_modules, dist, *.bak …).]" "(-1 --no-recursive){-1,--no-recursive}[Only the target directory itself, no subdirectories.]" "--max-depth=[Descend at most N levels below the target directory.]:N: " "--hidden[Also process dotfiles and dot-directories.]" "--symlinks[Follow symlinked files (they are skipped by default).]" "--gitignore[Honour .gitignore files (including the global excludesfile).]" "--max-size=[Skip files larger than SIZE (default 100MB; a bare number means megabytes).]:SIZE: " "--min-size=[Skip files smaller than SIZE.]:SIZE: " "--newer-than=[Only files modified within AGE (e.g. 24h, 7d, 30m).]:AGE: " "--older-than=[Only files not modified within AGE.]:AGE: " "--binary[Process files that look binary instead of skipping them.]" "(-R --regex){-R,--regex}[Treat PATTERN as a Python regular expression.]" "--ere[Treat PATTERN as a POSIX Extended Regular Expression (grep -E syntax).]" "--pcre[Treat PATTERN as a Perl-compatible regular expression.]" "--pattern-kind=[Explicit pattern kind\: fixed, regex, ere or pcre.]:KIND:(fixed|regex|ere|pcre)" "(-i --ignore-case){-i,--ignore-case}[Case-insensitive matching.]" "(-w --word-boundary){-w,--word-boundary}[Match whole words only.]" "(-m --multiline){-m,--multiline}[Allow the pattern to span line boundaries ('.' matches newline).]" "--no-escapes[Do not interpret \\n, \\t, \\xNN in fixed patterns/replacements.]" "(-L --line-range){-L,--line-range}=[Restrict edits to a line range\: 10, 10-20, 10- or -20.]:RANGE: " "(-M --max-count){-M,--max-count}=[Replace at most N occurrences per file.]:N: " "--no-global[Replace only the first occurrence on each line.]" "--context=[Lines of context around a match in preview/diff output (default 3).]:N: " "(-n --dry-run){-n,--dry-run}[Report what would change; never write, never create a session.]" "--diff[Show a unified diff of every change (implies a preview).]" "(-I --interactive){-I,--interactive}[Confirm every hunk before it is written.]" "(-E --encoding){-E,--encoding}=[Force an encoding (utf-8, cp1251, latin-1 …); default is auto-detect.]:NAME: " "--encoding-error=[What to do with undecodable bytes\: strict (skip), replace, ignore.]:POLICY:(strict|replace|ignore)" "--backup[Store originals in a session so the run can be rolled back (default on).]" "--backup-dir=[Where to keep sessions (default <target>/.sr). Use an absolute path to keep them out of the tree.]:DIR:_files" "--keep=[Keep at most N sessions; older ones are pruned after a run (default 20, 0 disables pruning).]:N: " "--keep-age=[Also drop sessions older than AGE (e.g. 30d).]:AGE: " "--lock[Take an advisory lock so two sr runs cannot interleave (default on).]" "--confirm-threshold=[Ask for confirmation when more than N files would change (0 disables).]:N: " "--allow-root[Permit a mutating run with euid 0 (refused by default).]" "(-f --force){-f,--force}[Override safety guards (drifted files, read-only warnings, existing targets).]" "(-y --yes){-y,--yes}[Answer 'yes' to every prompt; required for unattended runs in CI.]" "--porcelain[Emit stable 'path\:line\:col\:text' records, one per match.]" "--progress[Show a progress bar on a terminal (default on).]" "--summary[Print the run summary (default on).]" '*:file:_files'
      ;;
    rollback)
      _arguments -s : $global_opts "(-f --force){-f,--force}[Override safety guards (drifted files, read-only warnings, existing targets).]" "(-y --yes){-y,--yes}[Answer 'yes' to every prompt; required for unattended runs in CI.]" '*:file:_files'
      ;;
    sessions)
      _arguments -s : $global_opts "--keep=[Keep at most N sessions; older ones are pruned after a run (default 20, 0 disables pruning).]:N: " "--keep-age=[Also drop sessions older than AGE (e.g. 30d).]:AGE: " "(-y --yes){-y,--yes}[Answer 'yes' to every prompt; required for unattended runs in CI.]" '*:file:_files'
      ;;
    update)
      _arguments -s : $global_opts "(-y --yes){-y,--yes}[Answer 'yes' to every prompt; required for unattended runs in CI.]" '*:file:_files'
      ;;
    doctor)
      _arguments -s : $global_opts  '*:file:_files'
      ;;
    completions)
      _arguments -s : $global_opts  '*:file:_files'
      ;;
    config)
      _arguments -s : $global_opts  '*:file:_files'
      ;;
    selftest)
      _arguments -s : $global_opts  '*:file:_files'
      ;;
    help)
      _arguments -s : $global_opts  '*:file:_files'
      ;;
    *)
      _arguments -s : $global_opts '*:file:_files'
      ;;
  esac
}
_sr "$@"
